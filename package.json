{
  "name": "tiny-cqrs",
  "version": "0.2.0",
  "description": "A tiny, storage-agnostic CQRS/event-sourcing core. Bring your own database, your own domain types, your own deployment target.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./adapters/memory": "./src/adapters/memory.ts",
    "./adapters/d1": "./src/adapters/d1.ts",
    "./signing": "./src/signing.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.19",
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.7.3",
    "vitest": "~2.1.9",
    "wrangler": "^4.0.0"
  }
}
